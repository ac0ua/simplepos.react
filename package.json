{
  "name": "simplepos",
  "version": "1.0.0",
  "description": "Simple POS - Modern Point of Sales System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "build:output": "node scripts/build-output.js",
    "build:server": "set VITE_BASE=/tools/simplepos/ && node scripts/build-output.js",
    "start": "cd backend && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
