PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=simplepos-secret-key-change-in-production
NODE_ENV=development

# Database (for production)
DB_HOST=localhost
# DB_PORT=5432
DB_PORT=3306
DB_NAME=simplepos
DB_USER=root
DB_PASSWORD=
# Set to 'true' to auto-alter database schema on startup (slower startup, useful during development)
# Set to 'false' or omit for faster startup (recommended for production)
DB_AUTO_ALTER=false

# Redis (for production caching)
REDIS_URL=redis://localhost:6379

# Payment Gateway (for future implementation)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Email Service (for receipts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
