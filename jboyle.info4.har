            "text": ".kds-container{display:flex;flex-direction:column;height:100vh;width:100%;background-color:#102217;font-family:Inter,sans-serif}.kds-header{display:flex;justify-content:space-between;align-items:center;padding:2rem;border-bottom:1px solid rgba(255,255,255,.1)}.kds-header h1{font-size:3rem;font-weight:900;color:#fff;letter-spacing:-.015em}.auto-refresh{color:#fff9;font-size:.875rem}.kds-main{flex:1;overflow:auto;padding:2rem}.kds-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:2rem;height:100%}.category-card{display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:.75rem;padding:1.5rem;text-align:center;box-shadow:0 20px 25px -5px #0000001a,0 10px 10px -5px #0000000a;cursor:pointer;transition:transform .2s}.category-card:hover{transform:scale(1.05)}.category-card.pending{background-color:#991b1bcc}.category-card.done{background-color:#166534cc}.category-name{color:#fff;font-size:3rem;font-weight:900;line-height:1.2;letter-spacing:-.015em;margin-bottom:2rem}.category-badge{display:flex;align-items:center;justify-content:center;width:12rem;height:12rem;border-radius:50%;border:8px solid white;margin:2rem 0}.pending-badge{background-color:#dc2626}.done-badge{background-color:#16a34a}.badge-number{color:#fff;font-weight:900;font-size:6rem}.material-symbols-outlined{font-size:7.5rem;color:#fff}.view-button{width:100%;max-width:20rem;padding:1.25rem 1.5rem;background-color:#ffffffe6;color:#7f1d1d;font-size:2.25rem;font-weight:700;border:none;border-radius:.75rem;cursor:pointer;transition:background-color .2s}.view-button:hover{background-color:#fff}.done-button{width:100%;max-width:20rem;padding:1.25rem 1.5rem;background-color:#ffffff80;color:#14532d;font-size:2.25rem;font-weight:700;border-radius:.75rem;opacity:.7}.prepared-count{margin-top:1rem;color:#fff;font-size:1.25rem;opacity:.8}.kds-loading,.kds-error,.kds-empty{grid-column:1 / -1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:400px;color:#fff}.kds-loading{font-size:1.5rem}.error-icon,.empty-icon{font-size:3rem;margin-bottom:1rem}.error-icon{color:#ef4444}.error-title,.empty-title{font-size:1.875rem;font-weight:700;margin-bottom:.5rem}.error-message,.empty-subtitle{font-size:1.25rem;color:#fff9;margin-bottom:1rem}.error-details{font-size:.875rem;color:#fff9;margin-bottom:1.5rem}.retry-button{margin-top:1.5rem;padding:.75rem 1.5rem;background-color:#fff3;color:#fff;border:none;border-radius:.75rem;font-size:1rem;cursor:pointer;transition:background-color .2s}.retry-button:hover{background-color:#ffffff4d}@media (max-width: 768px){.kds-header h1,.category-name{font-size:2rem}.category-badge{width:10rem;height:10rem}.badge-number{font-size:4.5rem}}.kds-category-container{display:flex;flex-direction:column;height:100vh;width:100%;background-color:#102217;font-family:Inter,sans-serif;color:#fff}.kds-category-header{display:flex;justify-content:space-between;align-items:center;padding:2rem;border-bottom:1px solid rgba(255,255,255,.1)}.kds-category-header h1{font-size:3rem;font-weight:900;letter-spacing:-.015em}.back-button{display:flex;align-items:center;gap:.75rem;padding:1rem 1.5rem;background-color:#fff3;color:#fff;font-size:1.5rem;font-weight:700;border:none;border-radius:.75rem;cursor:pointer;transition:background-color .2s}.back-button:hover{background-color:#ffffff4d}.back-button .material-symbols-outlined{font-size:2.5rem}.back-button-text{display:none}@media (min-width: 768px){.back-button-text{display:inline}}.kds-category-main{flex:1;display:flex;flex-direction:column;overflow:auto}.tabs-container{flex-shrink:0;border-bottom:1px solid rgba(255,255,255,.1)}.tabs-nav{display:flex}.tab-button{flex:1;text-align:center;padding:1.5rem;font-size:2.25rem;font-weight:700;border:none;border-bottom:8px solid transparent;background:transparent;color:#ffffff80;cursor:pointer;transition:all .2s;position:relative}.tab-button:hover{background-color:#ffffff0d;color:#fffc}.tab-button.active{border-bottom-color:#13ec6a;color:#13ec6a;background-color:#13ec6a1a}.tab-badge{position:absolute;top:1rem;margin-left:.75rem;display:flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;border-radius:50%;background-color:#dc2626;color:#fff;font-size:1.5rem;font-weight:700}.items-container{flex:1;overflow:auto;padding:2rem}.items-grid{display:grid;grid-template-columns:1fr;gap:2rem}.item-card{display:flex;flex-direction:column;gap:1rem;border-radius:.75rem;padding:1.5rem;box-shadow:0 20px 25px -5px #0000001a}.item-card.pending{background-color:#991b1bcc}.item-card.prepared{background-color:#166534cc}@media (min-width: 768px){.item-card{flex-direction:row;align-items:stretch}}.item-info{flex:1;display:flex;align-items:center;justify-content:center}.item-name{font-size:4rem;font-weight:900;color:#fff}@media (min-width: 768px){.item-name{font-size:4.5rem;justify-content:flex-start}}.item-controls{display:flex;flex-direction:column;gap:.75rem}.quantity-controls{display:flex;align-items:center;justify-content:center;gap:1rem}.quantity-button{display:flex;align-items:center;justify-content:center;padding:1rem;background-color:#fff3;color:#fff;border:none;border-radius:.75rem;cursor:pointer;transition:background-color .2s}.quantity-button:hover{background-color:#ffffff4d}.quantity-button .material-symbols-outlined{font-size:3rem}.quantity-display{display:flex;align-items:center;justify-content:center;width:6rem;height:6rem;border-radius:.75rem;background-color:#0000004d;font-size:3.75rem;font-weight:900;color:#fff}.mark-done-button{display:flex;align-items:center;justify-content:center;gap:.625rem;padding:1.25rem 2rem;background-color:#ffffffe6;color:#7f1d1d;font-size:1.875rem;font-weight:700;border:none;border-radius:.75rem;cursor:pointer;transition:background-color .2s}.mark-done-button:hover{background-color:#fff}.prepared-check{display:flex;align-items:center;justify-content:center;width:6rem;height:6rem;border-radius:5