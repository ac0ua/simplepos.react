            "size": 6034,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link\n      rel=\"icon\"\n      type=\"image/svg+xml\"\n      href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%232196F3'/%3E%3Ctext x='50%25' y='50%25' dy='.35em' text-anchor='middle' font-family='sans-serif' font-size='24' fill='white'%3ESP%3C/text%3E%3C/svg%3E\"\n    />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta name=\"theme-color\" content=\"#2196F3\" />\n    <meta name=\"description\" content=\"Simple POS - Modern Point of Sales System\" />\n    <title>Simple POS</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/icon?family=Material+Icons\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined\" rel=\"stylesheet\">\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      \n      body {\n        font-family: 'Roboto', sans-serif;\n        -webkit-font-smoothing: antialiased;\n        -moz-osx-font-smoothing: grayscale;\n      }\n      \n      #root {\n        min-height: 100vh;\n      }\n      \n      .loading-container {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        height: 100vh;\n        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        gap: 24px;\n      }\n      \n      .loading-icon-container {\n        position: relative;\n        width: 120px;\n        height: 120px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n      }\n      \n      .loading-icon {\n        font-family: 'Material Symbols Outlined';\n        font-size: 80px;\n        color: white;\n        position: absolute;\n        opacity: 0;\n        filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));\n        animation: slideIcon 7.5s ease-in-out infinite;\n      }\n      \n      .loading-icon:nth-child(1) {\n        animation-delay: 0s;\n      }\n      \n      .loading-icon:nth-child(2) {\n        animation-delay: 1.5s;\n      }\n      \n      .loading-icon:nth-child(3) {\n        animation-delay: 3s;\n      }\n      \n      .loading-icon:nth-child(4) {\n        animation-delay: 4.5s;\n      }\n      \n      .loading-icon:nth-child(5) {\n        animation-delay: 6s;\n      }\n      \n      .loading-bg-circle {\n        position: absolute;\n        width: 100px;\n        height: 100px;\n        border-radius: 50%;\n        background: rgba(255, 255, 255, 0.2);\n        animation: pulse 2s ease-in-out infinite;\n      }\n      \n      .loading-text {\n        color: white;\n        font-size: 24px;\n        font-weight: 600;\n        letter-spacing: 1px;\n      }\n      \n      .loading-dots {\n        display: flex;\n        gap: 8px;\n        margin-top: 8px;\n      }\n      \n      .loading-dot {\n        width: 10px;\n        height: 10px;\n        border-radius: 50%;\n        background: white;\n        animation: dotPulse 1.5s ease-in-out infinite;\n      }\n      \n      .loading-dot:nth-child(1) {\n        animation-delay: 0s;\n      }\n      \n      .loading-dot:nth-child(2) {\n        animation-delay: 0.3s;\n      }\n      \n      .loading-dot:nth-child(3) {\n        animation-delay: 0.6s;\n      }\n      \n      @keyframes slideIcon {\n        0% {\n          transform: translateX(-150px) rotate(-45deg) scale(0.5);\n          opacity: 0;\n        }\n        10% {\n          transform: translateX(0) rotate(0deg) scale(1);\n          opacity: 1;\n        }\n        20% {\n          transform: translateX(0) rotate(0deg) scale(1);\n          opacity: 1;\n        }\n        30% {\n          transform: translateX(150px) rotate(45deg) scale(0.5);\n          opacity: 0;\n        }\n        100% {\n          transform: translateX(150px) rotate(45deg) scale(0.5);\n          opacity: 0;\n        }\n      }\n      \n      @keyframes pulse {\n        0%, 100% {\n          transform: scale(1);\n          opacity: 0.3;\n        }\n        50% {\n          transform: scale(1.1);\n          opacity: 0.2;\n        }\n      }\n      \n      @keyframes dotPulse {\n        0%, 100% {\n          transform: scale(1);\n          opacity: 0.4;\n        }\n        50% {\n          transform: scale(1.5);\n          opacity: 1;\n        }\n      }\n    </style>\n    <script type=\"module\" crossorigin src=\"/tools/simplepos/assets/index-DqXG6Kkg.js\"></script>\n    <link rel=\"modulepreload\" crossorigin href=\"/tools/simplepos/assets/vendor-Com4vLcY.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/tools/simplepos/assets/mui-Cb6oagOy.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/tools/simplepos/assets/utils-B8ZuYb4f.js\">\n    <link rel=\"stylesheet\" crossorigin href=\"/tools/simplepos/assets/index-CUuhi-Q5.css\">\n  <link rel=\"manifest\" href=\"/tools/simplepos/manifest.webmanifest\"><script id=\"vite-plugin-pwa:register-sw\" src=\"/tools/simplepos/registerSW.js\"></script></head>\n  <body>\n    <div id=\"root\">\n      <div class=\"loading-container\">\n        <div class=\"loading-icon-container\">\n          <div class=\"loading-bg-circle\"></div>\n          <span class=\"loading-icon\">local_pizza</span>\n          <span class=\"loading-icon\">fastfood</span>\n          <span class=\"loading-icon\">local_drink</span>\n          <span class=\"loading-icon\">cake</span>\n          <span class=\"loading-icon\">restaurant</span>\n        </div>\n        <div style=\"text-align: center;\">\n          <div class=\"loading-text\">SimplePOS</div>\n          <div class=\"loading-dots\">\n            <div class=\"loading-dot\"></div>\n            <div class=\"loading-dot\"></div>\n            <div class=\"loading-dot\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </body>\n</html>\n"
