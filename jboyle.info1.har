          "content": {
            "size": 4871,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n\r\n<head>\r\n  <!-- Basic Meta Tags -->\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n\r\n  <!-- Primary SEO Meta Tags -->\r\n  <title>Petabreed - Advanced Livestock & Pet Breeding Management Software</title>\r\n  <meta name=\"description\"\r\n    content=\"Professional breeding management platform with AI-powered genetic insights, multi-generation pedigree tracking, and comprehensive herd management. Free to start, unlimited animals with Pro.\" />\r\n  <meta name=\"keywords\"\r\n    content=\"livestock management, breeding software, pedigree tracking, herd management, animal genetics, breeding records, livestock database, pet breeding, AI breeding insights, genetic profiling\" />\r\n  <meta name=\"author\" content=\"Petabreed\" />\r\n  <meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" />\r\n\r\n  <!-- Canonical URL -->\r\n  <link rel=\"canonical\" href=\"https://app.petabreed.com/\" />\r\n\r\n  <!-- Open Graph / Facebook Meta Tags -->\r\n  <meta property=\"og:type\" content=\"website\" />\r\n  <meta property=\"og:url\" content=\"https://app.petabreed.com/\" />\r\n  <meta property=\"og:title\" content=\"Petabreed - Advanced Livestock & Pet Breeding Management Software\" />\r\n  <meta property=\"og:description\"\r\n    content=\"Professional breeding management platform with AI-powered genetic insights, multi-generation pedigree tracking, and comprehensive herd management. Free to start, unlimited animals with Pro.\" />\r\n  <meta property=\"og:image\" content=\"https://app.petabreed.com/og-image.png\" />\r\n  <meta property=\"og:image:width\" content=\"1200\" />\r\n  <meta property=\"og:image:height\" content=\"630\" />\r\n  <meta property=\"og:site_name\" content=\"Petabreed\" />\r\n  <meta property=\"og:locale\" content=\"en_US\" />\r\n\r\n  <!-- Twitter Card Meta Tags -->\r\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n  <!-- Performance Optimization - Preconnect to External Domains -->\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n  <link rel=\"preconnect\" href=\"https://www.paypal.com\" />\r\n  <link rel=\"dns-prefetch\" href=\"https://www.paypal.com\" />\r\n\r\n  <!-- Google Fonts - Optimized Loading -->\r\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap\" />\r\n\r\n  <!-- Structured Data - Organization & WebApplication Schema -->\r\n  <script type=\"application/ld+json\">\r\n    {\r\n      \"@context\": \"https://schema.org\",\r\n      \"@graph\": [\r\n        {\r\n          \"@type\": \"Organization\",\r\n          \"name\": \"Petabreed\",\r\n          \"url\": \"https://app.petabreed.com\",\r\n          \"logo\": \"https://app.petabreed.com/logo.png\",\r\n          \"description\": \"Advanced livestock and pet breeding management software with AI-powered genetic insights, pedigree tracking, and comprehensive herd management tools.\",\r\n          \"contactPoint\": {\r\n            \"@type\": \"ContactPoint\",\r\n            \"contactType\": \"Customer Support\",\r\n            \"email\": \"contact@petabreed.com\"\r\n          }\r\n        },\r\n        {\r\n          \"@type\": \"WebApplication\",\r\n          \"name\": \"Petabreed\",\r\n          \"url\": \"https://app.petabreed.com\",\r\n          \"applicationCategory\": \"BusinessApplication\",\r\n          \"operatingSystem\": \"Web Browser\",\r\n          \"description\": \"Professional livestock breeding management platform with advanced genetics tracking, AI-powered insights, and multi-generation pedigree visualization.\",\r\n          \"offers\": {\r\n            \"@type\": \"Offer\",\r\n            \"price\": \"0\",\r\n            \"priceCurrency\": \"USD\",\r\n            \"description\": \"Free tier available with premium Pro subscription options\"\r\n          },\r\n          \"featureList\": [\r\n            \"Unlimited animal records\",\r\n            \"Multi-generation pedigree charts\",\r\n            \"Advanced genetic profiling\",\r\n            \"AI-powered breeding insights\",\r\n            \"Breeding pair recommendations\",\r\n            \"Health and trait tracking\",\r\n            \"Referral rewards program\"\r\n          ]\r\n        }\r\n      ]\r\n    }\r\n    </script>\r\n\r\n  <!-- PayPal SDK - Subscription Support -->\r\n  <!-- ✅ CONFIGURED with CONNECTED APP Client ID -->\r\n  <script\r\n    src=\"https://www.paypal.com/sdk/js?client-id=AbFKmhPf2ByL1YxIW9WNKaEM8ao3WhsSM9RdQw05SYoMVL8KggU3jpO-g6m90AkclTByLJlt7UY-XY-n&currency=USD&vault=true&intent=subscription\"></script>\r\n  <script type=\"module\" crossorigin src=\"/assets/index-kfDB1m6W.js\"></script>\n  <link rel=\"modulepreload\" crossorigin href=\"/assets/vendor-BS3kDN0a.js\">\n  <link rel=\"modulepreload\" crossorigin href=\"/assets/mui-DJi3XLOY.js\">\n  <link rel=\"stylesheet\" crossorigin href=\"/assets/index-ChNCyX5y.css\">\n</head>\r\n\r\n<body>\r\n  <div id=\"root\"></div>\r\r\n</body>\r\n\r\n</html>"
